# WaterScience Customer Support AI - Environment Configuration

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# LLM Provider Configuration
# Supported providers: "mock" (default, zero-cost, deterministic), "openai", "groq", "anthropic"
LLM_PROVIDER=mock

# API Keys (leave empty to use built-in mock/demo mode)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# LLM Model Name (optional, defaults to gpt-4o-mini / llama-3.3-70b-versatile / claude-3-5-haiku)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
